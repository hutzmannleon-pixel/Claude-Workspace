{
  "name": "kaminfeger-termine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kaminfeger Verwaltung: Zeitfenster pro Straße, Buchung durch Bewohner, Prüfung durch den Betreiber",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "TEST_MODE=1 node --disable-warning=ExperimentalWarning --watch server/index.js & vite web",
    "build": "vite build web",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "test-mode": "TEST_MODE=1 node --disable-warning=ExperimentalWarning server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test server/test/*.test.js",
    "reset-passkeys": "node --disable-warning=ExperimentalWarning server/reset-passkeys.js",
    "launch-check": "node --disable-warning=ExperimentalWarning server/launch.js check",
    "go-live": "node --disable-warning=ExperimentalWarning server/launch.js go-live"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.2",
    "@fastify/static": "^10.1.5",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "fastify": "^5.12.5",
    "html-to-image": "^1.11.13",
    "nodemailer": "^10.0.12"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@phosphor-icons/web": "^2.1.1",
    "@vitejs/plugin-react": "^6.1.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.1"
  }
}
