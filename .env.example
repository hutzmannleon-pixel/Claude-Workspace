# ---- Pflicht ----
# Ihre Domain (ohne https://) – für das HTTPS-Zertifikat
DOMAIN=termine.example.de
# Öffentliche Adresse der App – wird in E-Mail-Links verwendet
BASE_URL=https://termine.example.de
# Langes Zufallsgeheimnis, z. B. erzeugen mit: openssl rand -hex 32
APP_SECRET=
# Wer sich als Betreiber anmelden darf (kommagetrennt)
ADMIN_EMAILS=ich@example.de
# Testbetrieb: nur diese Adressen (oder @domain.de) dürfen sich anmelden/Mails bekommen. Leer = alle.
ALLOWED_EMAILS=
# Angaben für Impressum/Datenschutz
OPERATOR_NAME=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=
NODE_ENV=production

# ---- E-Mail-Versand (SMTP, z. B. Brevo, Mailjet, Amazon SES Frankfurt) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Kaminfeger-Termine <no-reply@example.de>

# ---- Nur zum Ausprobieren, NIE in Produktion ----
# TEST_MODE=1
